# ---------------------------------------------------------------------------
# LLM-as-a-Judge Calibration Pipeline - environment template
# Copy to .env and fill in. NEVER commit the real .env (it is git-ignored).
# ---------------------------------------------------------------------------

# Judge backend: auto | api | mock
#   auto -> use the hosted API when OPENAI_API_KEY is set, otherwise the
#           deterministic offline reference judge (so the pipeline always runs)
#   api  -> force the hosted OpenAI-compatible API (fails if no key)
#   mock -> force the deterministic offline reference judge
JUDGE_MODE=auto

# Hosted model configuration (OpenAI-compatible). The automated tester injects
# its own key into the variable named in submission.json -> env_mapping.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Model used as the judge (see submission.json).
JUDGE_MODEL=gpt-4o-mini

# Hard budget ceiling in USD. The judge raises JudgeBudgetExceeded once the
# running spend counter crosses this value.
JUDGE_BUDGET_USD=5.00

# Determinism
RANDOM_SEED=42
BOOTSTRAP_ITERATIONS=1000

# --- Optional judge tuning -------------------------------------------------
# Number of train examples embedded as few-shot. 0 (default) = use all 37 (keeps
# the committed reference numbers); set a small number (e.g. 6) to shorten the
# prompt when serving a slow local model.
JUDGE_FEWSHOT=0
# Per-request timeout (s) and retries for the hosted client.
JUDGE_TIMEOUT=120
JUDGE_MAX_RETRIES=1
# Cap on generated tokens per judge call.
JUDGE_MAX_TOKENS=400
# When the hosted API fails (bad key / no credits / offline), fall back to the
# deterministic mock instead of crashing. Set 0 to fail loudly instead.
JUDGE_API_FALLBACK=1
